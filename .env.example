# =============================================================================
# ai-marketing-growth-os environment configuration
# Copy to .env and adjust. Demo mode needs NO keys (AI_MARKETING_PROVIDER=mock).
# =============================================================================

# Provider: mock (default, zero cost) | openai | anthropic
AI_MARKETING_PROVIDER=mock

# Optional API keys - only needed for non-demo providers. NEVER commit real keys.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Per-run budget cap in USD (demo mode is always $0)
AI_MARKETING_COST_CAP_USD=1.0

# Where sample data lives (defaults to repo data/sample_data)
GROWTH_OS_DATA_DIR=

# Where the frontend static files live (defaults to repo frontend)
GROWTH_OS_FRONTEND_DIR=

# Backend host/port
GROWTH_OS_HOST=0.0.0.0
GROWTH_OS_PORT=8000
